# Copy to .env.local and fill in from your EmailJS dashboard (emailjs.com).
# Add the same three keys in Vercel > Project > Settings > Environment Variables.

# Email Services > your service > Service ID
NEXT_PUBLIC_EMAILJS_SERVICE_ID= 
# Email Templates > your template > Settings > Template ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Account > General > Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
